{
  "name": "erp-mt-suite",
  "version": "1.0.0",
  "description": "ERP MT Suite — Unified Node.js App for TezHost Deluxe Pro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "migrate:seed": "npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "build": "echo 'Frontend is pre-built. Upload build/ folder to the server.'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.0",
    "nodemailer": "^6.9.7",
    "sequelize": "^6.35.0",
    "sequelize-cli": "^6.6.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
