# EzeeFlo Employee App - Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC=true
EXPO_PUBLIC_ENABLE_GPS_ATTENDANCE=true
EXPO_PUBLIC_ENABLE_OFFLINE_ATTENDANCE=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# App Settings
EXPO_PUBLIC_APP_NAME=EzeeFlo Employee
EXPO_PUBLIC_APP_VERSION=1.0.0
