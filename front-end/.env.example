# Backend API URL — uses proxy in dev (package.json), change to full URL when not using proxy
# Dev (proxy): /api
# Production: https://your-api-server.com/api
REACT_APP_API_URL=/api

# Full backend URL — used by apiClient for direct backend calls (logo images, file uploads etc.)
# Leave empty when using CRA proxy in development
# Production: https://your-api-server.com
REACT_APP_BASE_URL=

# Frontend dev server port
PORT=3001
