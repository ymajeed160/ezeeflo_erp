# ============================================================
# EzeeFlo Loyalty - Environment Configuration
# ============================================================

# Server
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001
APP_URL=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ezeeflo_loyalty
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=your-256-bit-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@ezeeflo.com

# SMS (Future)
SMS_PROVIDER=
SMS_API_KEY=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
